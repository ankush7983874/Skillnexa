{
  "name": "skillnexa-platform",
  "version": "1.0.0",
  "description": "AI-Powered Academia-Industry Collaboration & Talent Intelligence Platform",
  "main": "backend/server.ts",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "npm --prefix ai-service run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "academia",
    "industry",
    "collaboration",
    "talent-intelligence",
    "skill-mapping",
    "internship",
    "placement",
    "ai"
  ],
  "author": "SkillNexa Team",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.13",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  }
}
