# SkillNexa Platform Environment Configuration

# Server & Client Setup
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# Database Connection (MongoDB Atlas for Production / Local MongoDB for Dev)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skillnexa?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=skillnexa_super_secret_jwt_key_2026_production_ready
JWT_EXPIRES_IN=7d

# Embedded AI Engine (Optional external fallback service URL)
AI_SERVICE_URL=http://localhost:8000

# SMTP / Email Notification Service (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="SkillNexa Platform <no-reply@skillnexa.com>"
SMTP_SECURE=false
